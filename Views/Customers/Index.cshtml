@model IEnumerable<WebAppMVC.Models.Customer>

@{
	ViewData["Title"] = "Customers";
}


	<a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Phone</th>
			<th>Address</th>
			<th>City</th>
			<th>Province</th>
			<th>Country</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
@foreach (var item in Model) {
	<tr>
		<td>@item.Name</td>
		<td>@item.Email</td>
		<td>@item.Phone</td>
		<td>@item.Address</td>
		<td>@item.City</td>
		<td>@item.Province</td>
		<td>@item.Country</td>
		<td>
			<a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
			<a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
			<a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
		</td>
	</tr>
}
	</tbody>
</table>
